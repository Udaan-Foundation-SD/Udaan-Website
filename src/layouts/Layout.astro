---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Udaan Foundation',
	description = 'Udaan Foundation funds grassroots organizations across India.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Turn on scroll motion before first paint, unless the visitor prefers reduced motion (see src/scripts/motion.ts) -->
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
		</script>
	</head>
	<body class="text-ink min-h-screen bg-white antialiased">
		<slot />
		<script>
			import '../scripts/motion.ts';
		</script>
	</body>
</html>
