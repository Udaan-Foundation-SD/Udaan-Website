---
// Team tool: build your Udaan email signature, copy it, paste it into Gmail.
// Not linked from the site, kept out of search (noindex) and out of the sitemap (astro.config.mjs).
// The signature is plain inline-styled HTML because email clients ignore stylesheets and web fonts;
// the logo is served from /email/ on the live site so it loads in anyone's inbox.
import Layout from '../layouts/Layout.astro';
import { TEAM, SOCIALS, DONATE_CHECKOUT_URL } from '../data/site';
// Italic Garamond for the profile-picture initials (matches the wordmark); only this page loads it
import '@fontsource-variable/eb-garamond/wght-italic.css';

const site = (Astro.site ?? new URL('https://www.udaanfoundationsd.org')).href.replace(/\/$/, '');
const instagram = SOCIALS.find((s) => s.label === 'Instagram')?.href ?? '';
const people = TEAM.map((m) => ({ name: m.name, role: m.role, color: m.color ?? '' }));
const config = { site, instagram, donate: DONATE_CHECKOUT_URL ? `${site}/donate/` : '' };
---

<Layout
	title="Email Signature | Udaan Foundation SD"
	description="Build your Udaan Foundation SD email signature and paste it into Gmail."
	noindex
>
	<main class="px-6 pt-14 pb-28 lg:px-12 lg:pt-24 lg:pb-36">
		<div class="mx-auto max-w-5xl">
			<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase">For the team</p>
			<h1 class="text-ink mt-3 font-serif text-4xl leading-[1.05] font-medium tracking-[-0.015em] md:text-5xl">
				Your email signature
			</h1>
			<p class="font-ui mt-4 max-w-xl text-[15px] leading-relaxed text-stone-600">
				Pick your name, check the preview, then copy it into Gmail. It's added to the bottom of every email you send
				from your @udaanfoundationsd.org account.
			</p>

			<div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14">
				<!-- Form -->
				<div class="min-w-0 lg:col-span-5">
					<p class="font-ui text-[13px] font-semibold text-stone-500">Quick pick</p>
					<div class="mt-3 flex flex-wrap gap-2" id="people">
						{
							people.map((p) => (
								<button
									type="button"
									class="font-ui rounded-full border border-stone-200 px-3 py-1 text-[13px] text-stone-600 transition-colors hover:border-stone-300 hover:text-ink aria-pressed:border-leaf aria-pressed:bg-leaf aria-pressed:text-white"
									data-name={p.name}
									data-role={p.role}
									data-color={p.color}
									aria-pressed="false"
								>
									{p.name}
								</button>
							))
						}
					</div>

					<div class="mt-8 space-y-5">
						<label class="block">
							<span class="font-ui text-[13px] font-semibold text-stone-500">Name</span>
							<input
								id="sig-name"
								type="text"
								autocomplete="off"
								placeholder="Your name"
								class="font-ui text-ink mt-1.5 block w-full rounded-md border border-stone-200 bg-white px-3 py-2 text-[15px] outline-none focus:border-leaf focus:ring-2 focus:ring-leaf/15"
							/>
						</label>
						<label class="block">
							<span class="font-ui text-[13px] font-semibold text-stone-500">Role</span>
							<input
								id="sig-role"
								type="text"
								autocomplete="off"
								placeholder="e.g. Marketing Lead"
								class="font-ui text-ink mt-1.5 block w-full rounded-md border border-stone-200 bg-white px-3 py-2 text-[15px] outline-none focus:border-leaf focus:ring-2 focus:ring-leaf/15"
							/>
						</label>
						<p class="font-ui text-[12.5px] leading-relaxed text-stone-400">
							Full name or first name and last initial, whichever you prefer. No phone numbers or home addresses.
						</p>
					</div>
				</div>

				<!-- Preview, framed like the end of an email -->
				<div class="min-w-0 lg:col-span-7">
					<p class="font-ui text-[13px] font-semibold text-stone-500">Preview</p>
					<div class="mt-3 overflow-x-auto rounded-xl border border-stone-200 bg-white p-5 shadow-[0_1px_2px_rgba(0,0,0,0.04)] md:p-8">
						<p class="text-[14px] leading-6 text-stone-500" style="font-family: Arial, Helvetica, sans-serif">
							Warmly,
						</p>
						<div class="mt-4" id="sig-preview"></div>
					</div>

					<div class="mt-5 flex flex-wrap items-center gap-4">
						<button
							type="button"
							id="sig-copy"
							class="font-ui bg-leaf hover:bg-leaf-deep inline-flex items-center justify-center rounded-md px-6 py-2 text-[13.5px] leading-5 font-semibold text-white transition-colors disabled:cursor-not-allowed disabled:opacity-40"
						>
							Copy signature
						</button>
						<p id="sig-status" class="font-ui text-[13px] text-stone-500" role="status" aria-live="polite"></p>
					</div>
				</div>
			</div>

			<!-- Setup steps -->
			<div class="mt-20 border-t border-stone-200 pt-10">
				<h2 class="text-ink font-serif text-2xl font-medium md:text-3xl">Add it to Gmail</h2>
				<ol class="font-ui mt-6 grid gap-6 text-[14px] leading-relaxed text-stone-600 md:grid-cols-2 lg:grid-cols-4">
					<li>
						<span class="text-leaf block text-[12px] font-semibold">01</span>
						Open Gmail on a computer, signed in to your <span class="text-ink font-medium">@udaanfoundationsd.org</span> account.
					</li>
					<li>
						<span class="text-leaf block text-[12px] font-semibold">02</span>
						Click the gear icon, then <span class="text-ink font-medium">See all settings</span>, and scroll to
						<span class="text-ink font-medium">Signature</span>.
					</li>
					<li>
						<span class="text-leaf block text-[12px] font-semibold">03</span>
						Click <span class="text-ink font-medium">Create new</span>, name it "Udaan", and paste into the box.
					</li>
					<li>
						<span class="text-leaf block text-[12px] font-semibold">04</span>
						Under <span class="text-ink font-medium">Signature defaults</span>, choose it for new emails and replies, then
						click <span class="text-ink font-medium">Save Changes</span> at the very bottom.
					</li>
				</ol>
			</div>

			<!-- Profile picture: initials in the wordmark's italic Garamond, with its flight path and bird -->
			<div class="mt-20 border-t border-stone-200 pt-10">
				<h2 class="text-ink font-serif text-2xl font-medium md:text-3xl">Profile picture</h2>
				<p class="font-ui mt-3 max-w-xl text-[15px] leading-relaxed text-stone-600">
					No headshot? Use this instead. It shows next to your name in Gmail, Meet, and Chat. It uses the name you picked
					above.
				</p>

				<div class="mt-8 flex flex-col gap-10 md:flex-row md:items-start md:gap-14">
					<div class="flex items-end gap-6">
						<canvas id="pfp" width="800" height="800" class="size-44 rounded-full ring-1 ring-black/5 md:size-52"
						></canvas>
						<!-- Roughly the size it appears in an inbox -->
						<div class="pb-1 text-center">
							<img id="pfp-small" alt="" class="size-10 rounded-full ring-1 ring-black/5" />
							<p class="font-ui mt-2 text-[11px] text-stone-400">Inbox size</p>
						</div>
					</div>

					<div class="min-w-0">
						<p class="font-ui text-[13px] font-semibold text-stone-500">Background</p>
						<div class="mt-3 flex flex-wrap gap-2.5" id="pfp-swatches"></div>

						<button
							type="button"
							id="pfp-download"
							class="font-ui bg-leaf hover:bg-leaf-deep mt-7 inline-flex items-center justify-center rounded-md px-6 py-2 text-[13.5px] leading-5 font-semibold text-white transition-colors"
						>
							Download picture
						</button>

						<ol class="font-ui mt-7 space-y-2 text-[14px] leading-relaxed text-stone-600">
							<li>
								<span class="text-leaf mr-1.5 text-[12px] font-semibold">01</span> Go to
								<a href="https://myaccount.google.com/" class="text-ink font-medium underline decoration-stone-300 underline-offset-2 hover:decoration-leaf"
									>myaccount.google.com</a
								>, signed in to your Udaan account.
							</li>
							<li>
								<span class="text-leaf mr-1.5 text-[12px] font-semibold">02</span> Click your current picture (or the
								letter in the circle), then <span class="text-ink font-medium">Change</span>.
							</li>
							<li>
								<span class="text-leaf mr-1.5 text-[12px] font-semibold">03</span> Upload the picture you downloaded and
								click <span class="text-ink font-medium">Save</span>.
							</li>
						</ol>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script is:inline>
	(() => {
		const canvas = document.getElementById('pfp');
		const small = document.getElementById('pfp-small');
		const swatchBox = document.getElementById('pfp-swatches');
		const nameInput = document.getElementById('sig-name');
		const ctx = canvas.getContext('2d');
		const W = canvas.width;
		const FONT = '"EB Garamond Variable", Garamond, Georgia, serif';

		// Wordmark geometry (same paths as src/components/Wordmark.astro): the flight path and bird that leave the last letter
		const SWOOSH = new Path2D('M270 85.6C297 95.5 318 77 327.5 46C321.8 80.5 298 101 270 91.4Z');
		const BIRD = new Path2D(
			'M60 18C58 15.5 55 13.5 52 14C49 14.5 47 17 44 21.5C39 13 31 5.5 21 2C25.5 9.5 28 18 29.5 27C24 30.5 18 33.5 12 35.5L2 33.5L8.5 40L3.5 47L14 41.5C28 41 41 35 50 26.5C54 23.5 57 20.5 60 18Z',
		);
		const BIRD_M = new DOMMatrix().translate(305, 8).scale(0.8).rotate(-24);
		// In wordmark units: where the last letter ends on the baseline, and how tall a capital is
		const ANCHOR = { x: 276, y: 101 };
		const CAP_UNITS = 66.8;
		// Accent bounds in wordmark units (swoosh + transformed bird)
		const birdPts = [
			[2, 2],
			[60, 2],
			[2, 47],
			[60, 47],
		].map(([x, y]) => BIRD_M.transformPoint({ x, y }));
		const ACC = {
			maxX: Math.max(327.5, ...birdPts.map((p) => p.x)),
			minY: Math.min(46, ...birdPts.map((p) => p.y)),
		};

		const base = [
			{ id: 'leaf', label: 'Udaan green', bg: '#2d7a3e', fg: '#ffffff', accent: '#b8e2c1' },
			{ id: 'canopy', label: 'Forest', bg: '#1b2316', fg: '#f5f3ee', accent: '#7cc48b' },
			{ id: 'paper', label: 'Paper', bg: '#f3f1ec', fg: '#1a1814', accent: '#2d7a3e' },
		];
		let teamColor = '';
		let current = 'leaf';

		const initials = (name) => {
			const words = name
				.replace(/[^\p{L}\s]/gu, ' ')
				.trim()
				.split(/\s+/)
				.filter(Boolean);
			if (!words.length) return 'U';
			const first = words[0][0];
			const last = words.length > 1 ? words[words.length - 1][0] : '';
			return (first + last).toUpperCase();
		};

		const swatches = () => (teamColor ? [...base, { id: 'team', label: 'Your team colour', bg: teamColor, fg: '#ffffff', accent: 'rgba(255,255,255,0.88)' }] : base);

		function renderSwatches() {
			const list = swatches();
			if (!list.some((s) => s.id === current)) current = 'leaf';
			swatchBox.innerHTML = '';
			for (const s of list) {
				const b = document.createElement('button');
				b.type = 'button';
				b.title = s.label;
				b.setAttribute('aria-label', s.label);
				b.setAttribute('aria-pressed', String(s.id === current));
				b.className =
					'size-9 rounded-full ring-1 ring-black/10 ring-offset-2 transition-shadow aria-pressed:ring-2 aria-pressed:ring-stone-900';
				b.style.background = s.bg;
				b.addEventListener('click', () => {
					current = s.id;
					renderSwatches();
					draw();
				});
				swatchBox.appendChild(b);
			}
		}

		function draw() {
			const style = swatches().find((s) => s.id === current);
			const text = initials(nameInput.value);
			let fs = text.length > 1 ? 360 : 400;

			// Measure the whole mark (letters + flight path + bird), shrinking until it fits inside the circle crop
			let m, s, left, right, top, bottom;
			for (let i = 0; i < 12; i++) {
				ctx.font = `italic 600 ${fs}px ${FONT}`;
				m = ctx.measureText(text);
				s = (m.actualBoundingBoxAscent * 0.98) / CAP_UNITS; // wordmark units → px, matched to cap height
				left = -m.actualBoundingBoxLeft;
				const inkRight = m.actualBoundingBoxRight;
				right = Math.max(inkRight, inkRight + (ACC.maxX - ANCHOR.x) * s);
				top = Math.min(-m.actualBoundingBoxAscent, (ACC.minY - ANCHOR.y) * s);
				bottom = m.actualBoundingBoxDescent;
				if (right - left <= W * 0.7 && bottom - top <= W * 0.56) break;
				fs *= 0.92;
			}

			// Centre the mark's bounding box, nudged down a touch so the letters (not the bird) sit at optical centre
			const x0 = (W - (right - left)) / 2 - left;
			const y0 = (W - (bottom - top)) / 2 - top + W * 0.015;

			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.fillStyle = style.bg;
			ctx.fillRect(0, 0, W, W);

			ctx.fillStyle = style.fg;
			ctx.font = `italic 600 ${fs}px ${FONT}`;
			ctx.textBaseline = 'alphabetic';
			ctx.fillText(text, x0, y0);

			// Flight path + bird, anchored to the end of the last letter on the baseline
			const endX = x0 + m.actualBoundingBoxRight;
			ctx.setTransform(s, 0, 0, s, endX - ANCHOR.x * s, y0 - ANCHOR.y * s);
			ctx.fillStyle = style.accent;
			ctx.fill(SWOOSH);
			const t = BIRD_M;
			ctx.transform(t.a, t.b, t.c, t.d, t.e, t.f);
			ctx.fill(BIRD);
			ctx.setTransform(1, 0, 0, 1, 0, 0);

			small.src = canvas.toDataURL('image/png');
		}

		function syncFromPicker() {
			const name = nameInput.value.trim();
			const match = Array.from(document.querySelectorAll('#people button')).find((p) => p.dataset.name === name);
			const color = match?.dataset.color || '';
			if (color !== teamColor) {
				teamColor = color;
				if (color) current = 'team';
				renderSwatches();
			}
			draw();
		}

		document.getElementById('pfp-download').addEventListener('click', () => {
			const text = initials(nameInput.value);
			canvas.toBlob((blob) => {
				if (!blob) return;
				const a = document.createElement('a');
				a.href = URL.createObjectURL(blob);
				a.download = `udaan-profile-${text}.png`;
				document.body.appendChild(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(a.href), 2000);
			}, 'image/png');
		});

		nameInput.addEventListener('input', syncFromPicker);
		// This script runs before the signature script, so wait a tick for the pill click to fill in the name first
		document.querySelectorAll('#people button').forEach((p) => p.addEventListener('click', () => setTimeout(syncFromPicker, 0)));

		renderSwatches();
		draw();
		// Redraw once the italic Garamond has loaded (the first pass may use a fallback font)
		document.fonts.load(`italic 600 100px ${FONT}`, 'AZ').then(draw).catch(() => {});
	})();
</script>

<script is:inline define:vars={{ config }}>
	const nameInput = document.getElementById('sig-name');
	const roleInput = document.getElementById('sig-role');
	const preview = document.getElementById('sig-preview');
	const copyBtn = document.getElementById('sig-copy');
	const status = document.getElementById('sig-status');
	const pills = Array.from(document.querySelectorAll('#people button'));

	const esc = (s) =>
		s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

	// Email-safe markup: tables, inline styles, system fonts, absolute image URLs.
	// Layout: the real wordmark (an image, so it keeps our Garamond lettering) | hairline | name, role, links.
	function signature(name, role, imgBase) {
		// Gmail can't load web fonts, so use each reader's own modern UI font:
		// SF Pro on Apple devices, Segoe UI on Windows, Roboto on Android, Helvetica/Arial as the last resort.
		const font =
			"font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,'Helvetica Neue',Helvetica,Arial,sans-serif;";
		const linkStyle = `color:#44403c;text-decoration:none;font-weight:500;${font}`;
		// Each link is icon + label, kept together so the row wraps between links, never inside one
		const item = (href, iconFile, label) =>
			`<span style="white-space:nowrap;display:inline-block;margin-right:14px;">` +
			`<a href="${href}" style="${linkStyle}"><img src="${imgBase}/email/${iconFile}" width="13" height="13" alt="" style="display:inline-block;width:13px;height:13px;border:0;vertical-align:-2px;margin-right:5px;">${label}</a>` +
			`</span>`;
		const links = [item(`${config.site}/`, 'icon-web.png', 'udaanfoundationsd.org')];
		if (config.instagram) links.push(item(config.instagram, 'icon-instagram.png', '@udaanfoundationsd'));
		if (config.donate) links.push(item(config.donate, 'icon-web.png', 'Donate'));
		return (
			`<table cellpadding="0" cellspacing="0" border="0" role="presentation" style="border-collapse:collapse;${font}">` +
			`<tr>` +
			// Wordmark column
			`<td width="132" style="width:132px;min-width:132px;vertical-align:middle;padding:0 18px 0 0;">` +
			`<a href="${config.site}/" style="text-decoration:none;"><img src="${imgBase}/email/udaan-wordmark.png" width="114" height="34" alt="Udaan Foundation SD" style="display:block;width:114px;height:34px;border:0;"></a>` +
			`<div style="font-size:9.5px;line-height:13px;letter-spacing:1.4px;text-transform:uppercase;color:#78716c;padding:6px 0 0 3px;white-space:nowrap;${font}">San Diego, CA</div>` +
			`</td>` +
			// Details column, set off by a green hairline
			`<td style="vertical-align:middle;border-left:1px solid #d6d3d1;padding:2px 0 2px 18px;${font}">` +
			// Name: semibold, slightly tightened. Role: small tracked capitals in green, like the labels on the site.
			`<div style="font-size:15px;line-height:20px;font-weight:600;letter-spacing:-0.2px;color:#1a1814;${font}">${esc(name)}</div>` +
			(role
				? `<div style="font-size:10.5px;line-height:15px;font-weight:600;letter-spacing:1.1px;text-transform:uppercase;color:#2d7a3e;padding-top:3px;${font}">${esc(role)}</div>`
				: '') +
			`<div style="font-size:12px;line-height:18px;padding-top:9px;${font}">${links.join('')}</div>` +
			`</td>` +
			`</tr>` +
			`</table>`
		);
	}

	function render() {
		const name = nameInput.value.trim();
		const role = roleInput.value.trim();
		// Preview loads the logo from wherever this page is served; the copied version always uses the live site.
		preview.innerHTML = signature(name || 'Your Name', role || 'Your role', location.origin);
		preview.style.opacity = name ? '1' : '0.45';
		copyBtn.disabled = !name;
		status.textContent = '';
		pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.name === name && p.dataset.role === role)));
	}

	pills.forEach((p) =>
		p.addEventListener('click', () => {
			nameInput.value = p.dataset.name;
			roleInput.value = p.dataset.role;
			render();
		}),
	);
	nameInput.addEventListener('input', render);
	roleInput.addEventListener('input', render);

	copyBtn.addEventListener('click', async () => {
		const name = nameInput.value.trim();
		const role = roleInput.value.trim();
		const html = signature(name, role, config.site);
		const text = [name, role, 'Udaan Foundation SD · San Diego', config.site.replace('https://www.', '')]
			.filter(Boolean)
			.join('\n');
		let ok = false;
		try {
			await navigator.clipboard.write([
				new ClipboardItem({
					'text/html': new Blob([html], { type: 'text/html' }),
					'text/plain': new Blob([text], { type: 'text/plain' }),
				}),
			]);
			ok = true;
		} catch {
			// Fallback for browsers without rich clipboard access: copy a hidden rendered copy
			const holder = document.createElement('div');
			holder.innerHTML = html;
			holder.style.cssText = 'position:fixed;left:-9999px;top:0;';
			document.body.appendChild(holder);
			const range = document.createRange();
			range.selectNodeContents(holder);
			const sel = window.getSelection();
			sel.removeAllRanges();
			sel.addRange(range);
			ok = document.execCommand('copy');
			sel.removeAllRanges();
			holder.remove();
		}
		status.textContent = ok ? 'Copied. Now paste it into Gmail.' : 'Copy didn’t work. Select the preview and copy it instead.';
	});

	render();
</script>
