---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import DonateForm from '../components/DonateForm.astro';
import cricket from '../assets/partners/gurukulam-cricket.jpg';
import { CONTACT_EMAIL, DONATE_CHECKOUT_URL, TAX_NOTE } from '../data/site';

// Online giving goes live when DONATE_CHECKOUT_URL (e.g. your Givebutter campaign link) is set in src/data/site.ts.
// Until then the form shows as a "coming soon" preview.
const live = Boolean(DONATE_CHECKOUT_URL);

// Process + FAQ copy is a draft that mirrors "How it works" — the team should confirm it matches what they do.
const afterYouGive = [
	{ title: 'You give', body: 'One-time or monthly. Every amount goes toward the same promise.' },
	{
		title: 'We fund a real need',
		body: 'Your gift supports a vetted partner like Gurukulam, toward something specific: supplies, meals, coaching, or staff.',
	},
	{ title: 'We show you what it did', body: 'We share updates and photos straight from the field, so you can see your gift at work.' },
];

const faq = [
	{
		q: 'Where does my money go?',
		a: 'To grassroots organizations in India that our team has vetted, like Gurukulam in Kanpur, toward specific needs. We only feature partners we know.',
	},
	{
		q: 'Can I give monthly?',
		a: live
			? 'Yes. Choose “Monthly” in the form above. Regular gifts help partners plan ahead.'
			: 'Yes. When online giving opens, you will be able to choose “Monthly” in the form above.',
	},
	...(live
		? []
		: [{ q: 'When can I donate?', a: 'Very soon. We are finishing setting up secure online giving. Please check back shortly.' }]),
	{ q: 'Who runs Udaan?', a: 'A team of high school students, with an adult advisor.', link: { label: 'Meet the team', href: '/team/' } },
	...(TAX_NOTE ? [{ q: 'Is my donation tax-deductible?', a: TAX_NOTE }] : []),
	...(CONTACT_EMAIL
		? [{ q: 'I have another question.', a: 'We would love to hear from you.', link: { label: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` } }]
		: []),
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout
	title="Donate | Udaan Foundation SD"
	description="Support vetted grassroots organizations across India, one-time or monthly. Your gift through Udaan Foundation SD goes toward specific, real needs on the ground."
>
	<main>
		<!-- Story on the left; the giving form in a dark "checkout card" on the right (a coming-soon preview until a checkout link is set) -->
		<section class="px-6 pt-12 lg:px-12 lg:pt-20">
			<div class="grid max-w-6xl items-start gap-12 lg:grid-cols-12 lg:gap-10">
				<div class="lg:col-span-6">
					<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>Donate</p>
					<h1
						class="text-ink mt-3 font-serif text-5xl leading-[1.02] font-medium tracking-[-0.02em] text-balance md:text-6xl lg:text-7xl"
						data-reveal
						style="--delay: 80ms"
					>
						Help them take flight.
					</h1>
					<p class="mt-6 max-w-lg font-serif text-lg leading-snug text-stone-500 md:text-xl" data-reveal style="--delay: 160ms">
						<span class="font-devanagari" lang="hi">उड़ान</span>, Udaan, means “flight.” Your gift supports grassroots
						organizations in India that are already doing the work, so the children they serve have room to rise.
					</p>
					<ul class="font-ui mt-8 space-y-2.5 text-[14px] text-stone-600" data-reveal style="--delay: 240ms">
						{
							['Every partner is vetted by our team', 'Gifts go toward specific, real needs', 'Updates come straight from the field'].map(
								(point) => (
									<li class="flex items-center gap-3">
										<span class="bg-leaf size-1.5 rounded-full" aria-hidden="true" />
										{point}
									</li>
								),
							)
						}
					</ul>
				</div>

				<div class="bg-canopy rounded-[20px] p-7 text-white md:p-10 lg:col-span-5 lg:col-start-8" data-reveal style="--delay: 200ms">
					<div class="flex items-center justify-between gap-4">
						<p class="font-serif text-2xl leading-tight">Choose your gift</p>
						{
							!live && (
								<span class="font-ui rounded-full bg-white/12 px-3 py-1 text-[10.5px] font-semibold tracking-[0.14em] text-white/80 uppercase">
									Coming soon
								</span>
							)
						}
					</div>
					<div class="mt-6">
						<DonateForm />
					</div>
					{live && <p class="font-ui mt-6 text-[12px] text-white/55">You'll finish on our payment partner's secure checkout.</p>}
				</div>
			</div>
		</section>

		<!-- Photo band: widens into place, photo drifts (data-widen + fx-parallax) -->
		<section class="pt-20 lg:pt-28">
			<figure
				class="relative mx-[calc(var(--inset-max)*var(--k,1))] h-[55svh] min-h-80 overflow-hidden rounded-[calc(8px+12px*var(--k,1))] bg-stone-200 [--inset-max:12px] lg:[--inset-max:48px]"
				data-widen
				data-scroll
			>
				<Image
					src={cricket}
					alt="Children in matching blue uniforms and cricket pads lined up with bats for practice on an open ground in Kanpur"
					widths={[640, 1024, 1600]}
					sizes="100vw"
					class="fx-parallax absolute inset-0 h-full w-full object-cover saturate-[.85] contrast-[1.03]"
				/>
				<figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/55 to-transparent px-6 pt-16 pb-5 md:px-10">
					<span class="font-ui text-[11px] font-semibold tracking-[0.14em] text-white/80">GURUKULAM, KANPUR</span>
					<span class="ml-3 font-serif text-[15px] text-white/90 italic">Cricket practice</span>
				</figcaption>
			</figure>
		</section>

		<!-- What happens after you give: lines draw in, one row at a time -->
		<section class="px-6 py-24 lg:px-12 lg:py-36">
			<div class="grid max-w-6xl gap-12 lg:grid-cols-12 lg:gap-10">
				<div class="lg:col-span-5">
					<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>After you give</p>
					<h2
						class="text-ink mt-3 font-serif text-4xl leading-[1.05] font-medium tracking-[-0.015em] text-balance md:text-5xl"
						data-reveal
						style="--delay: 80ms"
					>
						What happens to your gift.
					</h2>
				</div>
				<ol class="relative lg:col-span-6 lg:col-start-7">
					{
						afterYouGive.map((item, i) => (
							<li class="relative grid grid-cols-[2.5rem_1fr] gap-x-4 py-6">
								<span class="absolute inset-x-0 top-0 h-px bg-stone-200" aria-hidden="true" data-reveal="draw" style={`--delay: ${i * 160}ms`} />
								<span class="font-ui pt-1.5 text-[12px] font-semibold text-stone-400 tabular-nums">{pad(i + 1)}</span>
								<div data-reveal style={`--delay: ${i * 160 + 180}ms`}>
									<h3 class="text-ink font-serif text-2xl leading-tight font-medium">{item.title}</h3>
									<p class="mt-1.5 font-serif text-lg leading-snug text-stone-600">{item.body}</p>
								</div>
							</li>
						))
					}
					<li class="relative h-px" aria-hidden="true">
						<span class="absolute inset-x-0 top-0 h-px bg-stone-200" data-reveal="draw" style={`--delay: ${afterYouGive.length * 160}ms`} />
					</li>
				</ol>
			</div>
		</section>

		<!-- FAQ -->
		<section class="px-6 pb-24 lg:px-12 lg:pb-36">
			<div class="grid max-w-6xl gap-12 lg:grid-cols-12 lg:gap-10">
				<div class="lg:col-span-5">
					<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>Questions</p>
					<h2
						class="text-ink mt-3 font-serif text-4xl leading-[1.05] font-medium tracking-[-0.015em] md:text-5xl"
						data-reveal
						style="--delay: 80ms"
					>
						Good to know.
					</h2>
				</div>
				<div class="lg:col-span-6 lg:col-start-7">
					{
						faq.map((item, i) => (
							<details class="group relative border-b border-stone-200" data-reveal style={`--delay: ${i * 90}ms`}>
								<summary class="text-ink flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-serif text-xl [&::-webkit-details-marker]:hidden">
									{item.q}
									<span class="relative size-3.5 shrink-0" aria-hidden="true">
										<span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current" />
										<span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-current transition-transform duration-300 group-open:scale-y-0" />
									</span>
								</summary>
								<p class="max-w-lg pb-6 font-serif text-lg leading-snug text-stone-600">
									{item.a}
									{item.link && (
										<>
											{' '}
											<a href={item.link.href} class="text-leaf underline underline-offset-4">
												{item.link.label}
											</a>
										</>
									)}
								</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<!-- Closing: meet who you're supporting -->
		<section class="px-6 pb-24 lg:px-12 lg:pb-36">
			<div class="relative grid max-w-6xl items-end gap-8 pt-14 md:grid-cols-2">
				<span class="absolute inset-x-0 top-0 h-px bg-stone-200" aria-hidden="true" data-reveal="draw"></span>
				<h2 class="text-ink font-serif text-3xl leading-[1.1] font-medium tracking-[-0.01em] text-balance md:text-4xl" data-reveal>
					See who your gift supports.
				</h2>
				<div class="flex flex-wrap gap-3 md:justify-end" data-reveal style="--delay: 120ms">
					<Button href="/partners/" variant="secondary" arrow>Our partners</Button>
				</div>
			</div>
		</section>
	</main>
</Layout>
