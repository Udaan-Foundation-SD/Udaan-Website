---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title="Our Partners | Udaan Foundation SD"
	description="Meet the grassroots organizations Udaan Foundation SD vets and fundraises for, starting with Gurukulam, which gives children in Kanpur a free education."
>
	<main>
		<section class="px-6 pt-12 lg:px-12 lg:pt-20">
			<div class="max-w-6xl">
				<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>Our partners</p>
				<h1
					class="text-ink mt-3 max-w-3xl font-serif text-5xl leading-[1.02] font-medium tracking-[-0.02em] text-balance md:text-6xl lg:text-7xl"
					data-reveal
					style="--delay: 80ms"
				>
					The people doing the work.
				</h1>
				<p class="mt-6 max-w-xl font-serif text-lg leading-snug text-stone-500 md:text-xl" data-reveal style="--delay: 160ms">
					We partner with grassroots organizations that are rooted in their communities and doing real, visible work. Every
					one is vetted by our team.
				</p>
			</div>
		</section>

		<!-- One editorial row per partner: photo develops into colour as it arrives -->
		<section class="px-6 pt-16 pb-24 lg:px-12 lg:pt-24 lg:pb-36">
			<ul class="max-w-6xl space-y-20">
				{
					partners.map((partner, i) => (
						<li>
							<a
								href={`/partners/${partner.id}/`}
								class="group fx-develop grid items-center gap-8 md:grid-cols-12 md:gap-10"
								data-reveal
							>
								<div class:list={['overflow-hidden rounded-[14px] md:col-span-7', i % 2 === 1 && 'md:order-2 md:col-start-6']}>
									<Image
										src={partner.data.cover}
										alt={partner.data.coverAlt}
										loading={i === 0 ? 'eager' : 'lazy'}
										widths={[640, 1024, 1400]}
										sizes="(min-width: 768px) 58vw, 100vw"
										class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
									/>
								</div>
								<div class:list={['md:col-span-5', i % 2 === 1 && 'md:order-1']}>
									<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase">{partner.data.location}</p>
									<h2 class="text-ink mt-3 font-serif text-5xl leading-none font-medium tracking-[-0.02em]">{partner.data.name}</h2>
									{partner.data.nameHi && (
										<p class="font-devanagari mt-2 text-2xl text-stone-400" lang="hi">
											{partner.data.nameHi}
										</p>
									)}
									<p class="mt-5 font-serif text-lg leading-snug text-stone-600">{partner.data.summary}</p>
									<span class="font-ui text-leaf mt-6 inline-flex items-center gap-2 text-[13.5px] font-semibold">
										Read their story
										<svg
											viewBox="0 0 16 16"
											class="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											aria-hidden="true"
										>
											<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="px-6 pb-24 lg:px-12 lg:pb-36">
			<div class="relative grid max-w-6xl items-end gap-8 pt-14 md:grid-cols-2">
				<span class="absolute inset-x-0 top-0 h-px bg-stone-200" aria-hidden="true" data-reveal="draw"></span>
				<div data-reveal>
					<h2 class="text-ink font-serif text-3xl leading-[1.1] font-medium tracking-[-0.01em] text-balance md:text-4xl">
						Run a grassroots organization in India?
					</h2>
					<p class="font-devanagari mt-2 text-xl text-stone-400" lang="hi">क्या आप एक ज़मीनी संस्था चलाते हैं?</p>
				</div>
				<div class="flex flex-wrap gap-3 md:justify-end" data-reveal style="--delay: 120ms">
					<Button href="/apply/" arrow>Apply for funding</Button>
				</div>
			</div>
		</section>
	</main>
</Layout>
