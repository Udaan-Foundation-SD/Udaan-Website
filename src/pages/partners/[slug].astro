---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PressCard from '../../components/PressCard.astro';

export async function getStaticPaths() {
	const partners = await getCollection('partners');
	return partners.map((partner) => ({ params: { slug: partner.id }, props: { partner } }));
}

const { partner } = Astro.props;
const { Content } = await render(partner);
const p = partner.data;

// Editorial gallery: placements cycle so any number of photos gets a composed, staggered layout
const placements = [
	'md:col-span-5',
	'md:col-span-6 md:col-start-7 md:mt-24',
	'md:col-span-4 md:col-start-2 md:-mt-10',
	'md:col-span-5 md:col-start-7 md:mt-10',
	'md:col-span-5 md:col-start-3',
	'md:col-span-4 md:col-start-9 md:mt-20',
];
---

<Layout title={`${p.name} · Udaan Foundation`} description={p.summary}>
	<main>
		<!-- Header -->
		<section class="px-6 pt-10 lg:px-12 lg:pt-16">
			<div class="max-w-6xl">
				<nav class="font-ui text-[13px] text-stone-500" aria-label="Breadcrumb" data-reveal>
					<a href="/partners" class="hover:text-ink transition-colors">Partners</a>
					<span class="mx-2 text-stone-300" aria-hidden="true">/</span>
					<span class="text-ink">{p.name}</span>
				</nav>
				<h1 class="mt-8" data-reveal style="--delay: 80ms">
					<span class="text-ink block font-serif text-6xl leading-[0.95] font-medium tracking-[-0.02em] md:text-8xl">{p.name}</span>
					{
						p.nameHi && (
							<span class="font-devanagari mt-3 block text-3xl leading-none text-stone-400 md:text-5xl" lang="hi">
								{p.nameHi}
							</span>
						)
					}
				</h1>
				<p
					class="font-ui mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-semibold text-stone-500"
					data-reveal
					style="--delay: 160ms"
				>
					<span>{p.location}</span>
					<span class="size-1 rounded-full bg-stone-300" aria-hidden="true"></span>
					<span>{p.tagline}</span>
				</p>
				<p class="mt-6 max-w-2xl font-serif text-xl leading-snug text-stone-500 md:text-2xl" data-reveal style="--delay: 240ms">
					{p.summary}
				</p>
			</div>
		</section>

		<!-- Cover: widens into place, photo drifts -->
		<section class="pt-14 lg:pt-20">
			<figure
				class="relative mx-[calc(var(--inset-max)*var(--k,1))] h-[65svh] min-h-80 overflow-hidden rounded-[calc(8px+12px*var(--k,1))] bg-stone-200 [--inset-max:12px] lg:[--inset-max:48px]"
				data-widen
				data-scroll
			>
				<Image
					src={p.cover}
					alt={p.coverAlt}
					widths={[640, 1024, 1600]}
					sizes="100vw"
					loading="eager"
					class="fx-parallax absolute inset-0 h-full w-full object-cover saturate-[.85] contrast-[1.03]"
				/>
				{
					p.coverCaption && (
						<figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/55 to-transparent px-6 pt-16 pb-5 md:px-10">
							<span class="font-ui text-[11px] font-semibold tracking-[0.14em] text-white/80 uppercase">{p.name}</span>
							<span class="ml-3 font-serif text-[15px] text-white/90 italic">{p.coverCaption}</span>
						</figcaption>
					)
				}
			</figure>
		</section>

		<!-- Story, with the numbers pinned alongside on desktop -->
		<section class="px-6 py-20 lg:px-12 lg:py-32">
			<div class="grid max-w-6xl gap-14 lg:grid-cols-12 lg:gap-10">
				{
					p.stats.length > 0 && (
						<aside class="lg:col-span-4">
							<dl class="lg:sticky lg:top-36">
								{p.stats.map((stat, i) => (
									<div class="relative py-5" data-reveal style={`--delay: ${i * 140}ms`}>
										<span class="absolute inset-x-0 top-0 h-px bg-stone-200" aria-hidden="true" data-reveal="draw" style={`--delay: ${i * 140}ms`} />
										<dt class="sr-only">{stat.label}</dt>
										<dd>
											<span
												class="text-ink block font-serif text-5xl leading-none font-medium tabular-nums"
												data-count={stat.count}
												data-prefix={stat.prefix}
											>
												{stat.value}
											</span>
											<span class="font-ui mt-2 block text-[12px] font-semibold text-stone-500">{stat.label}</span>
										</dd>
									</div>
								))}
							</dl>
						</aside>
					)
				}
				<article class="prose-udaan lg:col-span-7 lg:col-start-6" data-reveal>
					<Content />
				</article>
			</div>
		</section>

		<!-- Gallery -->
		{
			p.photos.length > 0 && (
				<section class="px-6 pb-20 lg:px-12 lg:pb-32">
					<div class="max-w-6xl">
						<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>
							From the field
						</p>
						<div class="mt-8 grid grid-cols-2 gap-x-3 gap-y-10 md:grid-cols-12 md:gap-x-6 md:gap-y-12">
							{p.photos.map((photo, i) => (
								<figure
									class:list={[photo.portrait ? 'col-span-1' : 'col-span-2', placements[i % placements.length]]}
									data-reveal
									style={`--delay: ${(i % 2) * 120}ms`}
								>
									<div class:list={['overflow-hidden rounded-md bg-stone-100', photo.portrait ? 'aspect-[3/4]' : 'aspect-[4/3]']}>
										<Image
											src={photo.src}
											alt={photo.alt}
											widths={[480, 800, 1200]}
											sizes="(min-width: 768px) 45vw, 100vw"
											class="h-full w-full object-cover saturate-[.85] contrast-[1.03]"
										/>
									</div>
									<figcaption class="mt-3 flex items-baseline gap-3 text-stone-500">
										<span class="font-ui text-[11px] font-semibold tracking-[0.14em] tabular-nums">
											{String(i + 1).padStart(2, '0')}
										</span>
										<span class="font-serif text-[15px] italic">{photo.caption}</span>
									</figcaption>
								</figure>
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- Press -->
		{
			p.press && (
				<section class="px-6 pb-20 lg:px-12 lg:pb-32">
					<div class="grid max-w-6xl items-center gap-12 lg:grid-cols-12 lg:gap-10">
						<div class="lg:col-span-5">
							<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>
								In the press
							</p>
							<h2
								class="text-ink mt-3 font-serif text-4xl leading-[1.05] font-medium tracking-[-0.015em] text-balance md:text-5xl"
								data-reveal
								style="--delay: 80ms"
							>
								Recognized close to home.
							</h2>
						</div>
						<PressCard {...p.press} class="lg:col-span-6 lg:col-start-7" />
					</div>
				</section>
			)
		}

		<!-- Support -->
		<section class="pb-24 lg:pb-36">
			<div
				class="bg-canopy mx-[calc(var(--inset-max)*var(--k,1))] rounded-[calc(8px+12px*var(--k,1))] px-6 py-16 text-white [--inset-max:12px] md:px-12 lg:px-16 lg:py-20 lg:[--inset-max:48px]"
				data-widen
			>
				<div class="grid max-w-6xl items-end gap-8 md:grid-cols-2">
					<div data-reveal>
						<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-white/70 uppercase">Support their work</p>
						<h2 class="mt-3 font-serif text-4xl leading-[1.05] font-medium tracking-[-0.015em] text-balance md:text-5xl">
							Back partners like {p.name}.
						</h2>
					</div>
					<div class="flex flex-wrap gap-3 md:justify-end" data-reveal style="--delay: 120ms">
						<Button href="/donate" variant="secondary" arrow class="bg-white! hover:bg-stone-200!">
							Donate
						</Button>
						<a href="/partners" class="font-ui inline-flex items-center px-3 text-[13.5px] font-semibold text-white/80 hover:text-white">
							All partners
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
