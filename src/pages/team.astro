---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { TEAM, type TeamMember } from '../data/site';

// The team page, built from TEAM in src/data/site.ts:
//   - the headline carries a superscript count of students (like the numbers in the navbar)
//   - an optional team photo: save it as src/assets/team/group.jpg (or .png/.webp) and it appears under the intro
//   - one row per group: a small label on the left, people in a grid on the right (name, role, optional one-liner)
const groupPhoto = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../assets/team/group.{jpg,jpeg,png,webp}', { eager: true }),
)[0]?.default;

const studentCount = TEAM.filter((m) => !m.adult).length;

// Rows in the order each group first appears in TEAM
const groups = TEAM.reduce<{ label: string; members: TeamMember[] }[]>((rows, member) => {
	const row = rows.find((r) => r.label === member.group);
	if (row) row.members.push(member);
	else rows.push({ label: member.group, members: [member] });
	return rows;
}, []);
const isLead = (member: TeamMember) => /\blead\b/i.test(member.role);
const initials = (name: string) =>
	name
		.replace(/\./g, '')
		.split(/\s+/)
		.map((part) => part[0])
		.join('')
		.slice(0, 2)
		.toUpperCase();
---

<Layout
	title="Our Team | Udaan Foundation SD"
	description="Meet the San Diego high school students and adult advisor behind Udaan Foundation SD, funding vetted grassroots organizations that support children in India."
>
	<main>
		<!-- Intro -->
		<section class="px-6 pt-12 lg:px-12 lg:pt-20">
			<div class="max-w-6xl">
				<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase" data-reveal>Our team</p>
				<!-- One line on desktop; the count is tucked against "Udaan" (never wraps away from it) at cap height -->
				<h1
					class="text-ink mt-3 font-serif text-5xl leading-[1.02] font-medium tracking-[-0.02em] text-balance md:text-6xl lg:text-[4.25rem]"
					data-reveal
					style="--delay: 80ms"
				>
					The students behind <span class="whitespace-nowrap"
						>Udaan{
							studentCount > 0 && (
								<sup
									class="font-ui text-leaf relative top-[0.5em] ml-[0.12em] align-top text-[0.28em] leading-none font-semibold tracking-normal tabular-nums"
									aria-label={`, ${studentCount} students`}
								>
									{studentCount}
								</sup>
							)
						}</span
					>
				</h1>
				<p class="mt-6 max-w-xl font-serif text-lg leading-snug text-stone-500 md:text-xl" data-reveal style="--delay: 160ms">
					We're high school students in San Diego, most of us at Canyon Crest Academy, who believe the people already doing the work deserve the funding to keep doing it.
				</p>
			</div>
		</section>

		<!-- Optional team photo -->
		{
			groupPhoto && (
				<section class="px-6 pt-16 lg:px-12 lg:pt-20">
					<figure class="fx-develop max-w-6xl" data-reveal>
						<div class="aspect-[16/9] overflow-hidden rounded-xl bg-stone-100">
							<Image
								src={groupPhoto}
								alt="The Udaan Foundation SD team"
								widths={[640, 1024, 1600]}
								sizes="(min-width: 1280px) 1152px, 100vw"
								class="h-full w-full object-cover"
							/>
						</div>
					</figure>
				</section>
			)
		}

		<!-- The roster: one row per group, each row's top line draws in, then its people fade in one after another -->
		<section class="px-6 pt-16 lg:px-12 lg:pt-24">
			<div class="max-w-6xl">
				{
					groups.length > 0 ? (
						groups.map((group) => (
							<div class="relative grid gap-y-7 py-10 md:py-12 lg:grid-cols-12 lg:gap-x-10">
								<span class="absolute inset-x-0 top-0 h-px bg-stone-200" aria-hidden="true" data-reveal="draw" />
								<h2 class="font-ui pt-0.5 text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase lg:col-span-3" data-reveal>
									{group.label}
								</h2>
								<ul
									class:list={[
										'grid gap-x-6 md:gap-x-8 lg:col-span-9',
										// Same three-column grid for every row; the leads row is one column on phones so titles have room beside the headshots
										group.members.some(isLead) ? 'grid-cols-1 gap-y-8 sm:grid-cols-2 md:grid-cols-3 md:gap-y-9' : 'grid-cols-2 gap-y-9 md:grid-cols-3',
									]}
								>
									{group.members.map((member, i) =>
										isLead(member) ? (
											// Lead: same type scale and grid as the members below, plus a round headshot (a cut-out on their
											// own bright colour, or initials on it) and their one-line bio under the title
											<li class="flex items-start gap-3.5" data-reveal style={`--delay: ${80 + i * 60}ms`}>
												<span
													class:list={[
														'relative size-12 shrink-0 overflow-hidden rounded-full md:size-[3.25rem]',
														member.color ? 'ring-1 ring-black/5' : 'bg-stone-100 ring-1 ring-stone-200',
													]}
													style={member.color ? `background-color: ${member.color}` : undefined}
												>
													{member.photo ? (
														<Image src={member.photo} alt="" widths={[52, 104, 156]} sizes="52px" class="h-full w-full object-cover" />
													) : (
														<span
															class:list={[
																'font-ui flex h-full w-full items-center justify-center text-[13px] font-semibold tracking-wide',
																member.color ? 'text-white' : 'text-stone-400',
															]}
															aria-hidden="true"
														>
															{initials(member.name)}
														</span>
													)}
												</span>
												<div class="min-w-0 pt-0.5">
													<p class="font-ui text-ink text-[15px] leading-snug font-semibold md:text-base">{member.name}</p>
													<p class="font-ui text-leaf mt-0.5 text-[13px] leading-snug font-medium">
														{member.role}
														{member.grade && <span class="text-stone-400"> · {member.grade}</span>}
													</p>
													{member.bio && (
														<p class="font-ui mt-2 max-w-[17rem] text-[13px] leading-[1.5] text-pretty text-stone-500">{member.bio}</p>
													)}
												</div>
											</li>
										) : (
											<li data-reveal style={`--delay: ${80 + i * 60}ms`}>
												<p class="font-ui text-ink text-[15px] leading-snug font-semibold md:text-base">{member.name}</p>
												<p class="font-ui mt-1 text-[13px] leading-snug text-stone-500">
													{member.role}
													{member.grade && <span class="text-stone-400"> · {member.grade}</span>}
												</p>
												{member.bio && <p class="font-ui mt-2 max-w-[17rem] text-[13px] leading-[1.5] text-pretty text-stone-500">{member.bio}</p>}
											</li>
										),
									)}
								</ul>
							</div>
						))
					) : (
						<p class="font-serif text-xl text-stone-500">Team profiles are on their way.</p>
					)
				}
				<span class="block h-px bg-stone-200" aria-hidden="true" data-reveal="draw"></span>
			</div>
		</section>

		<!-- Closing call to action -->
		<section class="px-6 py-24 lg:px-12 lg:py-36">
			<div class="grid max-w-6xl items-end gap-8 md:grid-cols-2">
				<h2
					class="text-ink font-serif text-3xl leading-[1.1] font-medium tracking-[-0.01em] text-balance md:text-4xl"
					data-reveal
				>
					Want to back what we're building?
				</h2>
				<div class="flex flex-wrap gap-3 md:justify-end" data-reveal style="--delay: 120ms">
					<Button href="/donate/" arrow>Donate</Button>
					<Button href="/#how-it-works" variant="secondary">See how it works</Button>
				</div>
			</div>
		</section>
	</main>
</Layout>
