---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeaturedPartner from '../components/FeaturedPartner.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import Donate from '../components/Donate.astro';
import ForOrganizations from '../components/ForOrganizations.astro';
import { CONTACT_EMAIL, ORG_MISSION, ORG_NAME, SOCIALS } from '../data/site';

// Structured data (Schema.org JSON-LD) describing the organization and the site, for search engines.
const site = (Astro.site ?? new URL('https://www.udaanfoundationsd.org')).href; // ends in "/"
const sameAs = SOCIALS.map((social) => social.href);

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'NGO',
			'@id': `${site}#organization`,
			name: ORG_NAME,
			alternateName: ['Udaan Foundation', 'Udaan Foundation San Diego', 'Udaan'],
			url: site,
			logo: { '@type': 'ImageObject', url: `${site}logo.png`, width: 512, height: 512 },
			image: `${site}og-image.jpg`,
			description: ORG_MISSION,
			areaServed: { '@type': 'Country', name: 'India' },
			// Where we are (the "SD" in the name). City-level only: no street address is published.
			address: { '@type': 'PostalAddress', addressLocality: 'San Diego', addressRegion: 'CA', addressCountry: 'US' },
			// Udaan is a program of Excelar, its 501(c)(3) umbrella organization
			parentOrganization: { '@type': 'NGO', name: 'Excelar', taxID: '85-1861107', nonprofitStatus: 'Nonprofit501c3' },
			...(CONTACT_EMAIL && {
				email: CONTACT_EMAIL,
				contactPoint: { '@type': 'ContactPoint', contactType: 'general inquiries', email: CONTACT_EMAIL },
			}),
			...(sameAs.length > 0 && { sameAs }),
		},
		{
			'@type': 'WebSite',
			'@id': `${site}#website`,
			url: site,
			name: ORG_NAME,
			inLanguage: 'en',
			publisher: { '@id': `${site}#organization` },
		},
	],
};
---

<Layout
	title="Udaan Foundation SD | Funding Grassroots Work in India"
	description="Udaan Foundation SD is a San Diego student-led nonprofit that vets grassroots organizations in India and raises the funds they need to support more children."
	schema={schema}
>
	<main>
		<Hero />
		<Showcase />
		<HowItWorks />
		<FeaturedPartner />
		<WhoWeAre />
		<Donate />
		<ForOrganizations />
	</main>
</Layout>
