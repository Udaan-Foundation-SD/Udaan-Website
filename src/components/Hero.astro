---
import Button from './Button.astro';
---

<section class="px-6 pt-12 lg:px-12 lg:pt-20">
	<h1 class="text-ink font-serif text-5xl leading-[1.02] font-medium tracking-[-0.02em] text-balance md:text-6xl lg:text-7xl">
		The Udaan Foundation
	</h1>
	<p class="mt-6 max-w-xl font-serif text-lg leading-snug text-stone-500 md:text-xl">
		A student-led nonprofit based in San Diego, partnering with carefully vetted grassroots organizations across India. We bring them the
		donors and fundraising reach they can't access on their own, so more children get the support they need.
	</p>
	<div class="mt-9 flex flex-wrap gap-3">
		<Button href="/donate/" arrow>Donate</Button>
		<Button href="/partners/" variant="secondary">Meet our partners</Button>
	</div>
</section>
