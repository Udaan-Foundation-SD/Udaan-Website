---
import { DONATE_CHECKOUT_URL, DONATION_AMOUNTS, DEFAULT_DONATION } from '../data/site';

// Frequency + amount as radio chips (work without JS), styled for dark backgrounds.
// Submits to the payment provider's checkout (DONATE_CHECKOUT_URL) with ?frequency=…&amount=…
// Until that's set, the form is a preview: the button is disabled ("Donations opening soon") with a short note.
interface Props {
	/** Stagger the pieces in with data-reveal (used on the home page panel) */
	reveal?: boolean;
}

const { reveal = false } = Astro.props;
const live = Boolean(DONATE_CHECKOUT_URL);
const step = (ms: number) => (reveal ? { 'data-reveal': '', style: `--delay: ${ms}ms` } : {});
---

<form
	class="max-w-md"
	action={DONATE_CHECKOUT_URL || undefined}
	method="get"
	target={DONATE_CHECKOUT_URL ? '_blank' : undefined}
	data-donate
	data-checkout={DONATE_CHECKOUT_URL ? '' : undefined}
>
	<fieldset {...step(220)}>
		<legend class="font-ui mb-3 text-[11px] font-semibold tracking-[0.14em] text-white/60 uppercase">Frequency</legend>
		<div class="inline-flex rounded-md bg-white/10 p-1">
			{
				['One-time', 'Monthly'].map((label, i) => (
					<label class="cursor-pointer">
						<input type="radio" name="frequency" value={label.toLowerCase()} checked={i === 0} class="peer sr-only" />
						<span class="font-ui peer-checked:text-ink block rounded px-4 py-1.5 text-[13px] font-semibold text-white/75 transition-colors peer-checked:bg-white peer-focus-visible:outline-2 peer-focus-visible:outline-white">
							{label}
						</span>
					</label>
				))
			}
		</div>
	</fieldset>

	<fieldset class="mt-6" {...step(320)}>
		<legend class="font-ui mb-3 text-[11px] font-semibold tracking-[0.14em] text-white/60 uppercase">Amount</legend>
		<div class="grid grid-cols-4 gap-2">
			{
				DONATION_AMOUNTS.map((amount) => (
					<label class="cursor-pointer">
						<input type="radio" name="amount" value={amount} checked={amount === DEFAULT_DONATION} class="peer sr-only" />
						<span class="peer-checked:text-ink block rounded-md border border-white/25 py-2.5 text-center font-serif text-xl transition-colors peer-checked:border-white peer-checked:bg-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white hover:border-white/60">
							${amount}
						</span>
					</label>
				))
			}
		</div>
	</fieldset>

	<div {...step(420)}>
		{
			live ? (
				<button
					type="submit"
					class="group font-ui text-ink mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-6 py-2.5 text-[13.5px] leading-5 font-semibold transition-colors hover:bg-stone-200 sm:w-auto"
				>
					<span data-donate-label>Donate</span>
					<svg
						viewBox="0 0 16 16"
						class="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						aria-hidden="true"
					>
						<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			) : (
				<>
					<button
						type="button"
						disabled
						class="font-ui mt-8 inline-flex w-full cursor-not-allowed items-center justify-center rounded-md bg-white/85 px-6 py-2.5 text-[13.5px] leading-5 font-semibold text-stone-500 sm:w-auto"
					>
						Donations opening soon
					</button>
					<p class="font-ui mt-4 text-[13px] leading-snug text-white/70">
						Online giving is almost ready. Please check back soon, and thank you for wanting to help.
					</p>
				</>
			)
		}
	</div>
</form>

<script>
	// Keep the button label in sync with the choice, e.g. "Donate $50 monthly" (only once a checkout is connected).
	document.querySelectorAll<HTMLFormElement>('[data-donate][data-checkout]').forEach((form) => {
		const label = form.querySelector<HTMLElement>('[data-donate-label]');
		const sync = () => {
			const data = new FormData(form);
			const monthly = data.get('frequency') === 'monthly';
			if (label) label.textContent = `Donate $${data.get('amount')}${monthly ? ' monthly' : ''}`;
		};
		form.addEventListener('change', sync);
		sync();
	});
</script>
