---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import banyan from '../assets/banyan.jpg';
import cricket from '../assets/partners/gurukulam-cricket.jpg';
import openAirClass from '../assets/partners/gurukulam-open-air-class.jpg';
import snack from '../assets/partners/gurukulam-snack.jpg';
import girlsCricket from '../assets/partners/gurukulam-girls-cricket.jpg';
import ceremony from '../assets/partners/gurukulam-teachers-ceremony-2023.jpg';

// Partner photos for the editorial collage.
// To add one: put the file in src/assets/partners/, import it above, and add an entry (leave `src` out for a placeholder frame).
type Photo = {
	src?: ImageMetadata;
	alt: string;
	caption: string;
	place: string;
	span: string; // grid placement + vertical offset
	frame: string; // aspect ratio
	img?: string; // extra classes on the image (crop position, colour grade)
};

// Gentle shared grade so phone photos from different shoots sit together
const grade = 'saturate-[.85] contrast-[1.03]';

const photos: Photo[] = [
	{
		src: cricket,
		alt: 'Children in matching blue uniforms and cricket pads lined up with bats for practice on an open ground in Kanpur',
		caption: 'Cricket practice',
		place: 'Gurukulam, Kanpur',
		span: 'col-span-2 md:col-span-7',
		frame: 'aspect-[4/3]',
		img: grade,
	},
	{
		src: openAirClass,
		alt: 'A Gurukulam teacher kneels on a mat with a group of children holding notebooks during an outdoor class in a Kanpur basti',
		caption: 'An open-air class in the basti',
		place: 'Kanpur',
		span: 'col-span-1 md:col-span-5 md:mt-28',
		frame: 'aspect-[3/4]',
		img: grade,
	},
	{
		src: girlsCricket,
		alt: 'Girls in Gurukulam shirts, helmets, and batting pads practise their stance together on a dusty ground',
		caption: "Girls' batting practice",
		place: 'Gurukulam, Kanpur',
		span: 'col-span-1 md:col-span-5 md:col-start-2 md:-mt-32',
		frame: 'aspect-[3/4]',
		img: grade,
	},
	{
		src: snack,
		alt: 'A young boy in a white school shirt eats roasted chana from a lunchbox, with a banana and a Gurukulam card on his lap',
		caption: 'Chana and a banana after class',
		place: 'Gurukulam',
		span: 'col-span-1 md:col-span-4 md:col-start-8 md:mt-20',
		frame: 'aspect-[4/5]',
		img: `object-[50%_35%] ${grade}`,
	},
	{
		src: ceremony,
		alt: "A speaker at a podium and a smiling guest seated on stage at the 16th Sandipani Distinguished Teachers' Honour Ceremony, 2023",
		caption: "At a teachers' honour ceremony",
		place: '2023',
		span: 'col-span-1 md:col-span-4 md:col-start-4 md:-mt-10',
		frame: 'aspect-[3/4]',
		img: grade,
	},
];
---

<section id="partners" class="pt-14 lg:pt-24">
	<!-- Inset rounded panel that widens toward the screen edges as it scrolls up (--k: 1 → 0, set by data-widen in src/scripts/motion.ts) -->
	<div
		class="bg-canopy relative isolate mx-[calc(var(--inset-max)*var(--k,1))] overflow-clip rounded-[calc(8px+12px*var(--k,1))] [--inset-max:12px] lg:[--inset-max:48px]"
		data-showcase
		data-widen
	>
		<!-- Background pins to the viewport once the panel reaches the top (full width), while the photos scroll over it.
		     Needs overflow-clip (not overflow-hidden) on the panel, or sticky stops working. -->
		<div class="absolute inset-0 -z-10" aria-hidden="true">
			<div class="sticky top-0 h-svh">
				<Image
					src={banyan}
					alt=""
					widths={[640, 960, 1280, 1500]}
					sizes="100vw"
					class="h-full w-full object-cover object-[55%_top]"
				/>
				<div class="absolute inset-0 bg-black/30"></div>
			</div>
		</div>

		<div class="mx-auto max-w-6xl px-5 pt-12 pb-20 md:px-8 lg:pt-20 lg:pb-32">
			<header class="mb-10 max-w-xl text-white md:mb-14" data-reveal>
				<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-white/85 uppercase">From the field</p>
				<h2 class="mt-3 font-serif text-3xl leading-[1.08] font-medium tracking-[-0.015em] text-balance md:text-4xl lg:text-5xl">
					Real moments, shared by the partners we fund.
				</h2>
			</header>

			<div class="grid grid-cols-2 gap-x-3 gap-y-8 md:grid-cols-12 md:gap-x-6 md:gap-y-12">
				{
					photos.map((photo, i) => (
						<figure class={photo.span} data-reveal style={`--delay: ${(i % 2) * 120}ms`}>
							<div class:list={['overflow-hidden rounded-md', photo.frame]}>
								{photo.src ? (
									<Image
										src={photo.src}
										alt={photo.alt}
										widths={[480, 800, 1200]}
										sizes="(min-width: 768px) 50vw, 100vw"
										class:list={['h-full w-full object-cover', photo.img]}
									/>
								) : (
									<div class="font-ui flex h-full w-full flex-col items-center justify-center gap-2 border border-white/25 bg-white/10 text-white/75 backdrop-blur-sm">
										<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
											<rect x="3" y="5" width="18" height="14" rx="2" />
											<circle cx="9" cy="10" r="1.75" />
											<path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5" stroke-linejoin="round" />
										</svg>
										<span class="text-[11px] font-semibold tracking-[0.14em] uppercase">Partner photo</span>
									</div>
								)}
							</div>
							<figcaption class="mt-3 flex items-baseline gap-3 text-white/80">
								<span class="font-ui text-[11px] font-semibold tracking-[0.14em] tabular-nums">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span class="font-serif text-[15px] italic">
									{photo.caption} · {photo.place}
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

