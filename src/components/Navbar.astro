---
import Wordmark from './Wordmark.astro';
import BirdLogo from './BirdLogo.astro';
import Button from './Button.astro';

// Site-wide links (home sections use /#… so they work from any page)
const links = [
	{ label: 'How it works', href: '/#how-it-works' },
	{ label: 'Our partners', href: '/partners/' },
	{ label: 'Team', href: '/team/' },
	{ label: 'Get involved', href: '/#donate' },
];

// The page you're on (section links on the home page never count as "current")
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
const pad = (n: number) => String(n).padStart(2, '0');

// A hand-drawn underline: uneven bumps that drift slightly upward, like a quick pen stroke.
// Seeded by the label, so each link always gets the same stroke (no change between builds).
const handDrawn = (label: string) => {
	const w = Math.round(label.length * 7.4) + 6; // ≈ label width at 14.5px Manrope, plus a little overshoot
	let seed = [...label].reduce((s, c) => (s * 31 + c.charCodeAt(0)) >>> 0, 7);
	const rand = () => (seed = (seed * 1664525 + 1013904223) >>> 0) / 2 ** 32;
	const pts: [number, number][] = [];
	for (let x = 0, i = 0; x < w - 4; i++) {
		const baseline = 3.9 - 1.5 * (x / w); // starts low, ends a touch higher
		const bump = 0.35 + rand() * 0.85;
		pts.push([x, baseline + (i % 2 ? bump : -bump)]);
		x += 7 + rand() * 7;
	}
	pts.push([w, 2.3 + (rand() - 0.5) * 0.5]);
	// Smooth curve through the points (Catmull-Rom → cubic Bézier)
	const f = (n: number) => n.toFixed(2);
	let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
	for (let k = 0; k < pts.length - 1; k++) {
		const [p0, p1, p2, p3] = [pts[k - 1] ?? pts[k], pts[k], pts[k + 1], pts[k + 2] ?? pts[k + 1]];
		const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
		const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
		d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
	}
	return { w, d };
};
---

<!-- Full-width at the top; shrinks into a floating bordered card once the page scrolls (data-scrolled).
     The gap above the card is padding on the sticky header (a margin on the card would collapse and touch the top). -->
<header class="group font-ui sticky top-0 z-30 transition-[padding] duration-300 data-scrolled:px-3 data-scrolled:pt-2" data-site-header>
	<div
		class="mx-auto flex max-w-full items-center justify-between rounded-xl border border-transparent px-6 py-5 transition-all duration-300 group-data-scrolled:max-w-5xl group-data-scrolled:border-stone-200 group-data-scrolled:bg-white/85 group-data-scrolled:py-3 group-data-scrolled:shadow-[0_1px_12px_rgb(0_0_0/0.04)] group-data-scrolled:backdrop-blur-md lg:px-12 lg:group-data-scrolled:px-6"
	>
		<div class="flex items-center gap-6 xl:gap-9">
			<a href="/" class="text-ink block">
				<span class="sr-only">Udaan Foundation SD home</span>
				<Wordmark class="h-8 w-auto lg:h-9" title="" />
			</a>

			<!-- Desktop links echo the phone menu: numbered, and on hover a wavy green underline draws in -->
			<span class="hidden h-5 w-px bg-stone-200 lg:block" aria-hidden="true"></span>
			<ul class="hidden items-center gap-5 lg:flex xl:gap-7">
				{
					links.map(({ label, href }, i) => {
						const current = isCurrent(href);
						const wave = handDrawn(label);
						return (
							<li>
								<a
									href={href}
									class:list={[
										'nav-link group/link relative flex items-start gap-1 py-1 text-[14.5px] transition-colors duration-300',
										current ? 'text-ink' : 'hover:text-leaf text-stone-600',
									]}
									aria-current={current ? 'page' : undefined}
								>
									<span class="relative leading-6 whitespace-nowrap">
										{label}
										<svg
											class="nav-squiggle text-leaf pointer-events-none absolute bottom-0 -left-0.5 h-1.5 w-[calc(100%+6px)] overflow-visible"
											viewBox={`0 0 ${wave.w} 6`}
											preserveAspectRatio="none"
											aria-hidden="true"
										>
											<path d={wave.d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" pathLength="1" />
										</svg>
									</span>
									<span
										class:list={[
											'group-hover/link:text-leaf mt-0.5 text-[9.5px] font-semibold tracking-[0.08em] tabular-nums transition-colors',
											current ? 'text-leaf' : 'text-stone-400',
										]}
										aria-hidden="true"
									>
										{pad(i + 1)}
									</span>
								</a>
							</li>
						);
					})
				}
			</ul>
		</div>

		<div class="flex items-center gap-2.5">
			<Button href="/apply/" variant="secondary" class="max-md:hidden">Apply for funding</Button>
			<Button href="/donate/" arrow class="max-sm:hidden">Donate</Button>

			<button
				type="button"
				class="text-ink focus-visible:outline-leaf -mr-2 rounded-md p-2 focus-visible:outline-2 lg:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
			>
				<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
					<path d="M3.5 8.5h17M9.5 15.5h11" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<!--
	Full-screen phone menu. Opens as a circle expanding from the menu button (clip-path),
	then the links rise in one after another. Lives outside <header> so the header's
	backdrop blur can't trap it inside the floating card.
-->
<div
	id="mobile-menu"
	class="mobile-menu bg-canopy fixed inset-0 z-50 flex flex-col overflow-y-auto px-6 pt-5 pb-8 text-white [--wordmark-accent:#9fd3a9] lg:hidden"
	role="dialog"
	aria-modal="true"
	aria-label="Menu"
	inert
	data-mobile-menu
>
	<!-- Decorative bird hangs off the edge; its own clipped frame keeps the menu from scrolling sideways -->
	<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
		<BirdLogo class="absolute -right-16 bottom-28 h-64 w-auto text-white/[0.045]" />
	</div>

	<div class="relative flex items-center justify-between">
		<a href="/" class="mm-item block text-white" style="--i: 0">
			<span class="sr-only">Udaan Foundation SD home</span>
			<Wordmark class="h-8 w-auto" title="" />
		</a>
		<button
			type="button"
			class="-mr-2 rounded-md p-2 focus-visible:outline-2 focus-visible:outline-white"
			aria-label="Close menu"
			data-menu-close
		>
			<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
				<path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
			</svg>
		</button>
	</div>

	<nav class="relative mt-14 flex-1" aria-label="Main">
		<ol class="space-y-1">
			{
				links.map(({ label, href }, i) => (
					<li class="mm-item" style={`--i: ${i + 1}`}>
						<a href={href} class="group flex items-baseline gap-4 py-2.5">
							<span class="font-ui text-[11px] font-semibold tracking-[0.14em] text-white/45 tabular-nums">
								{String(i + 1).padStart(2, '0')}
							</span>
							<span class="font-serif text-[2.6rem] leading-[1.05] font-medium tracking-[-0.02em] transition-colors group-hover:text-white/70">
								{label}
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>

	<div class="mm-item relative mt-10 grid gap-3" style={`--i: ${links.length + 1}`}>
		<a
			href="/donate/"
			class="group font-ui text-ink flex items-center justify-center gap-2 rounded-md bg-white py-3 text-[14px] font-semibold transition-colors hover:bg-stone-200"
		>
			Donate
			<svg viewBox="0 0 16 16" class="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</a>
		<a
			href="/apply/"
			class="font-ui flex items-center justify-center rounded-md border border-white/25 py-3 text-[14px] font-semibold text-white transition-colors hover:border-white/60"
		>
			Apply for funding
		</a>
		<p class="mt-4 text-center text-sm text-white/45">
			<span class="font-devanagari" lang="hi">उड़ान</span>
			<span class="font-serif italic"> — flight</span>
		</p>
	</div>
</div>

<style>
	/* Desktop links: the wavy underline draws in from the left on hover, and stays drawn on the current page */
	.nav-squiggle path {
		stroke-dasharray: 1 1;
		stroke-dashoffset: 1;
	}
	.nav-link:hover .nav-squiggle path,
	.nav-link:focus-visible .nav-squiggle path,
	.nav-link[aria-current='page'] .nav-squiggle path {
		stroke-dashoffset: 0;
	}
	@media (prefers-reduced-motion: no-preference) {
		.nav-squiggle path {
			/* quick in the middle, easing off at the end, like a pen stroke */
			transition: stroke-dashoffset 0.65s cubic-bezier(0.5, 0.05, 0.2, 1);
		}
	}

	/* Closed: a zero-size circle at the menu button. Open: a circle big enough to cover the screen. */
	.mobile-menu {
		clip-path: circle(0px at var(--mx, calc(100% - 2.6rem)) var(--my, 2.6rem));
		visibility: hidden;
		transition:
			clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1),
			visibility 0s linear 0.7s;
	}
	.mobile-menu[data-open] {
		clip-path: circle(150vmax at var(--mx, calc(100% - 2.6rem)) var(--my, 2.6rem));
		visibility: visible;
		transition:
			clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1),
			visibility 0s;
	}

	/* Contents rise in one after another once the circle has mostly opened */
	.mm-item {
		opacity: 0;
		translate: 0 1.25rem;
		transition:
			opacity 0.3s ease,
			translate 0.3s ease;
	}
	.mobile-menu[data-open] .mm-item {
		opacity: 1;
		translate: 0 0;
		transition:
			opacity 0.6s ease calc(0.22s + var(--i, 0) * 60ms),
			translate 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) calc(0.22s + var(--i, 0) * 60ms);
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu {
			clip-path: none;
			opacity: 0;
			transition:
				opacity 0.2s ease,
				visibility 0s linear 0.2s;
		}
		.mobile-menu[data-open] {
			clip-path: none;
			opacity: 1;
			transition:
				opacity 0.2s ease,
				visibility 0s;
		}
		.mm-item,
		.mobile-menu[data-open] .mm-item {
			opacity: 1;
			translate: none;
			transition: none;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
	const closeButton = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');

	// Floating-card header once the page scrolls
	const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 16);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	const isOpen = () => menu?.hasAttribute('data-open') ?? false;

	const openMenu = () => {
		if (!menu || !toggle) return;
		// Grow the circle from the centre of the menu button
		const r = toggle.getBoundingClientRect();
		menu.style.setProperty('--mx', `${r.left + r.width / 2}px`);
		menu.style.setProperty('--my', `${r.top + r.height / 2}px`);
		menu.removeAttribute('inert');
		menu.setAttribute('data-open', '');
		toggle.setAttribute('aria-expanded', 'true');
		document.documentElement.style.overflow = 'hidden'; // stop the page scrolling behind
		closeButton?.focus({ preventScroll: true });
	};

	const closeMenu = (returnFocus = true) => {
		if (!menu || !toggle || !isOpen()) return;
		menu.removeAttribute('data-open');
		menu.setAttribute('inert', '');
		toggle.setAttribute('aria-expanded', 'false');
		document.documentElement.style.overflow = '';
		if (returnFocus) toggle.focus({ preventScroll: true });
	};

	toggle?.addEventListener('click', openMenu);
	closeButton?.addEventListener('click', () => closeMenu());

	// Tapping a link closes the menu (then the browser follows the link)
	menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(false)));

	// Esc closes; Tab stays inside the menu while it's open
	document.addEventListener('keydown', (event) => {
		if (!isOpen() || !menu) return;
		if (event.key === 'Escape') {
			event.preventDefault();
			closeMenu();
		} else if (event.key === 'Tab') {
			const focusable = [...menu.querySelectorAll<HTMLElement>('a, button')];
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		}
	});

	// Widening past the phone layout closes it
	window.matchMedia('(min-width: 1024px)').addEventListener('change', (query) => {
		if (query.matches) closeMenu(false);
	});
</script>
