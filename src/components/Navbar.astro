---
import BirdLogo from './BirdLogo.astro';
import Button from './Button.astro';

// Placeholder links — `menu: true` shows a dropdown chevron (dropdowns not wired up yet)
const links = [
	{ label: 'About', href: '#about', menu: true },
	{ label: 'Our Partners', href: '#partners', menu: true },
	{ label: 'Impact', href: '#impact' },
	{ label: 'Get Involved', href: '#get-involved' },
];
---

<!-- Full-width at the top; shrinks into a floating bordered card once the page scrolls (data-scrolled) -->
<header class="group font-ui sticky top-0 z-30 transition-[padding] duration-300 data-scrolled:px-3" data-site-header>
	<div
		class="mx-auto flex max-w-full items-center justify-between rounded-xl border border-transparent px-6 py-5 transition-all duration-300 group-data-scrolled:mt-3 group-data-scrolled:max-w-5xl group-data-scrolled:border-stone-200 group-data-scrolled:bg-white/85 group-data-scrolled:py-3 group-data-scrolled:shadow-[0_1px_12px_rgb(0_0_0/0.04)] group-data-scrolled:backdrop-blur-md lg:px-12 lg:group-data-scrolled:px-6"
	>
		<div class="flex items-center gap-12">
			<a href="/" class="text-ink flex items-center gap-2" aria-label="Udaan Foundation home">
				<BirdLogo class="h-6 w-auto" />
				<span class="text-xl font-bold tracking-tight">Udaan</span>
			</a>

			<ul class="hidden items-center gap-8 text-[15px] text-stone-600 lg:flex">
				{
					links.map(({ label, href, menu }) => (
						<li>
							<a href={href} class="hover:text-ink inline-flex items-center gap-1 transition-colors">
								{label}
								{menu && (
									<svg viewBox="0 0 12 12" class="size-3" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
										<path d="M3 4.5 6 7.5 9 4.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="flex items-center gap-2.5">
			<Button href="#apply" variant="secondary" class="max-md:hidden">Apply for funding</Button>
			<Button href="#donate" arrow class="max-sm:hidden">Donate</Button>

			<button
				type="button"
				class="text-ink -mr-2 p-2 lg:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-menu-toggle
			>
				<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" data-icon-open></path>
					<path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" class="hidden" data-icon-close></path>
				</svg>
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		class="absolute inset-x-3 top-full mt-2 hidden rounded-xl border border-stone-200 bg-white p-2 shadow-lg lg:hidden"
	>
		<ul class="text-ink text-base">
			{
				links.map(({ label, href }) => (
					<li>
						<a href={href} class="block rounded-lg px-4 py-3 hover:bg-stone-100">
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="mt-2 grid gap-2 p-2 md:hidden">
			<Button href="#donate" arrow class="py-2.5! sm:hidden">Donate</Button>
			<Button href="#apply" variant="secondary" class="py-2.5!">Apply for funding</Button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const menu = document.getElementById('mobile-menu');

	const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 16);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') !== 'true';
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		menu?.classList.toggle('hidden', !open);
		toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
		toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
	});
</script>
