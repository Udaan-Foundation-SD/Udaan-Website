---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A press clipping as a paper cutting that swings in and settles as you scroll (fx-pin),
// with the headline as a pull quote that lights up word by word (data-read-along).
interface Props {
	image: ImageMetadata;
	alt: string;
	outlet: string;
	date: string;
	quote: string;
	quoteNote?: string;
	class?: string;
}

const { image, alt, outlet, date, quote, quoteNote, class: className } = Astro.props;
---

<figure class={className}>
	<a
		href={image.src}
		target="_blank"
		rel="noopener"
		class="fx-pin relative block bg-white p-2 shadow-[0_18px_40px_-12px_rgb(0_0_0/0.25)]"
		aria-label={`Open the full ${outlet} article`}
		data-scroll
	>
		<Image src={image} alt={alt} widths={[480, image.width]} sizes="(min-width: 1024px) 40vw, 100vw" class="block h-auto w-full" />
		<span class="font-ui bg-ink absolute -top-3 left-5 rounded-sm px-2 py-1 text-[10px] font-semibold tracking-[0.14em] text-white uppercase">
			In the press
		</span>
	</a>
	<figcaption class="border-leaf mt-10 border-l-2 pl-5">
		<blockquote class="text-ink font-serif text-2xl leading-[1.2] italic md:text-[28px]" data-read-along>
			“{quote}”
		</blockquote>
		<p class="font-ui mt-3 text-[12px] font-semibold text-stone-500">
			{outlet} · {date}
			{quoteNote && <span class="font-normal">({quoteNote})</span>}
		</p>
	</figcaption>
</figure>
