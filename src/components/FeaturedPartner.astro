---
import Button from './Button.astro';
import PressCard from './PressCard.astro';
import press from '../assets/partners/gurukulam-press-dainik-jagran.jpg';

// Facts below come from the Dainik Jagran Kanpur feature (7 July 2026) — confirm with Gurukulam before launch.
// `count` makes the number count up when it scrolls into view (the final value stays in the HTML).
const stats = [
	{ value: '~150', count: 150, prefix: '~', label: 'children learning for free' },
	{ value: '₹0', label: 'in fees for their families' },
	{ value: '2026', label: 'featured in Dainik Jagran' },
];
---

<section id="gurukulam" class="pb-24 lg:pb-36">
	<!-- Light inset panel — widens into place like the banyan panel (data-widen) -->
	<div
		class="mx-[calc(var(--inset-max)*var(--k,1))] rounded-[calc(8px+12px*var(--k,1))] bg-stone-100 px-6 py-16 [--inset-max:12px] md:px-12 lg:px-16 lg:py-24 lg:[--inset-max:48px]"
		data-widen
	>
		<div class="mx-auto grid max-w-6xl items-start gap-14 lg:grid-cols-12 lg:gap-12">
			<!-- Story -->
			<div class="lg:col-span-7">
				<div data-reveal>
					<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-stone-500 uppercase">Featured partner</p>
					<h2 class="mt-5">
						<span class="text-ink block font-serif text-6xl leading-[0.95] font-medium tracking-[-0.02em] md:text-7xl">
							Gurukulam
						</span>
						<span class="font-devanagari mt-3 block text-3xl leading-none text-stone-400 md:text-4xl" lang="hi">
							गुरुकुलम
						</span>
					</h2>
				</div>

				<p
					class="font-ui mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-semibold text-stone-500"
					data-reveal
					style="--delay: 120ms"
				>
					<span>Kanpur, Uttar Pradesh</span>
					<span class="size-1 rounded-full bg-stone-300" aria-hidden="true"></span>
					<span>Free education for children from the city's bastis</span>
				</p>

				<div class="mt-8 max-w-xl space-y-4 font-serif text-lg leading-snug text-stone-600 md:text-xl">
					<p data-reveal>
						<span class="text-ink">Uddeshya Sachan once couldn't afford his own school fees.</span> Today he runs Gurukulam,
						where around 150 children from Kanpur's bastis study for free.
					</p>
					<p data-reveal style="--delay: 120ms">
						Alongside lessons, Gurukulam focuses on values, confidence, and practical skills, and the children get healthy
						snacks and cricket coaching too. It's exactly the kind of organization Udaan exists for: rooted in its
						community, doing real work every day, and held back mostly by funding.
					</p>
				</div>

				<dl class="relative mt-10 grid max-w-xl grid-cols-3">
					<span class="absolute inset-x-0 top-0 h-px bg-stone-300" aria-hidden="true" data-reveal="draw"></span>
					{
						stats.map((stat, i) => (
							<div
								class:list={['pt-5 pr-3', i > 0 && 'border-l border-stone-300 pl-4 md:pl-6']}
								data-reveal
								style={`--delay: ${250 + i * 140}ms`}
							>
								<dt class="sr-only">{stat.label}</dt>
								<dd>
									<span
										class="text-ink block font-serif text-3xl leading-none font-medium tabular-nums md:text-4xl"
										data-count={stat.count}
										data-prefix={stat.prefix}
									>
										{stat.value}
									</span>
									<span class="font-ui mt-2 block text-[12px] leading-snug font-semibold text-stone-500">{stat.label}</span>
								</dd>
							</div>
						))
					}
				</dl>

				<div class="mt-10 flex flex-wrap gap-3" data-reveal>
					<Button href="/donate" arrow>Support Gurukulam</Button>
					<Button href="/partners/gurukulam" variant="secondary" class="bg-white! hover:bg-stone-200!">Read their story</Button>
				</div>
			</div>

			<!-- Press: the clipping swings in and settles (fx-pin), then the headline reads along — shared PressCard -->
			<PressCard
				image={press}
				alt="Dainik Jagran Kanpur feature on Gurukulam, with a photo of founder Uddeshya Sachan surrounded by smiling children"
				outlet="Dainik Jagran, Kanpur"
				date="July 2026"
				quote="Breaking bad habits, instilling values, and spreading smiles."
				quoteNote="headline, translated from Hindi"
				class="lg:col-span-5 lg:pt-6"
			/>
		</div>
	</div>
</section>
