---
import { Image } from 'astro:assets';
import bicycles from '../assets/partners/gurukulam-bicycles.jpg';
import { DONATE_URL, DONATION_AMOUNTS, DEFAULT_DONATION } from '../data/site';

// Dark canopy panel — the second dark band on the page, mirroring the banyan panel.
// Amount + frequency are radio chips (work without JS); the script only updates the button label.
// The button goes to DONATE_URL — it does not take payments until a provider is connected.
---

<section id="donate" class="pb-24 lg:pb-36">
	<!-- Widens into place like the other panels (data-widen) -->
	<div
		class="bg-canopy mx-[calc(var(--inset-max)*var(--k,1))] grid overflow-hidden rounded-[calc(8px+12px*var(--k,1))] text-white [--inset-max:12px] lg:grid-cols-2 lg:[--inset-max:48px]"
		data-widen
	>
		<div class="px-6 py-14 md:px-12 lg:px-16 lg:py-20">
			<div data-reveal>
				<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-white/70 uppercase">Donate</p>
				<h2 class="mt-3 font-serif text-4xl leading-[1.05] font-medium tracking-[-0.015em] text-balance md:text-5xl">
					Help them take flight.
				</h2>
			</div>
			<p class="mt-5 max-w-md font-serif text-lg leading-snug text-white/80" data-reveal style="--delay: 120ms">
				<span class="font-devanagari" lang="hi">उड़ान</span>, Udaan, means “flight.” Your gift supports vetted grassroots
				partners like Gurukulam, so the children they serve have room to rise.
			</p>

			<form class="mt-10 max-w-md" action={DONATE_URL} data-donate>
				<fieldset data-reveal style="--delay: 220ms">
					<legend class="font-ui mb-3 text-[11px] font-semibold tracking-[0.14em] text-white/60 uppercase">Frequency</legend>
					<div class="inline-flex rounded-md bg-white/10 p-1">
						{
							['One-time', 'Monthly'].map((label, i) => (
								<label class="cursor-pointer">
									<input type="radio" name="frequency" value={label.toLowerCase()} checked={i === 0} class="peer sr-only" />
									<span class="font-ui peer-checked:text-ink block rounded px-4 py-1.5 text-[13px] font-semibold text-white/75 transition-colors peer-checked:bg-white peer-focus-visible:outline-2 peer-focus-visible:outline-white">
										{label}
									</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class="mt-6" data-reveal style="--delay: 320ms">
					<legend class="font-ui mb-3 text-[11px] font-semibold tracking-[0.14em] text-white/60 uppercase">Amount</legend>
					<div class="grid grid-cols-4 gap-2">
						{
							DONATION_AMOUNTS.map((amount) => (
								<label class="cursor-pointer">
									<input
										type="radio"
										name="amount"
										value={amount}
										checked={amount === DEFAULT_DONATION}
										class="peer sr-only"
									/>
									<span class="peer-checked:text-ink block rounded-md border border-white/25 py-2.5 text-center font-serif text-xl transition-colors peer-checked:border-white peer-checked:bg-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-white hover:border-white/60">
										${amount}
									</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<button
					type="submit"
					data-reveal
					style="--delay: 420ms"
					class="group font-ui text-ink mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-6 py-2.5 text-[13.5px] leading-5 font-semibold transition-colors hover:bg-stone-200 sm:w-auto"
				>
					<span data-donate-label>Donate</span>
					<svg
						viewBox="0 0 16 16"
						class="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						aria-hidden="true"
					>
						<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</form>
		</div>

		<!-- Photo drifts a little slower than the page (fx-parallax) -->
		<figure class="relative min-h-80 overflow-hidden lg:min-h-full" data-scroll>
			<Image
				src={bicycles}
				alt="Smiling Gurukulam students in matching blue polo shirts flash peace signs beside a row of new white bicycles"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 1024px) 50vw, 100vw"
				class="fx-parallax absolute inset-0 h-full w-full object-cover object-[50%_40%] saturate-[.85] contrast-[1.03]"
			/>
			<figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/55 to-transparent px-6 pt-16 pb-5 md:px-8">
				<span class="font-ui text-[11px] font-semibold tracking-[0.14em] text-white/80 tabular-nums">GURUKULAM</span>
				<span class="ml-3 font-serif text-[15px] text-white/90 italic">New bicycles, and big smiles</span>
			</figcaption>
		</figure>
	</div>
</section>

<script>
	// Keep the button label in sync with the chosen amount and frequency, e.g. "Donate $50 monthly".
	const form = document.querySelector<HTMLFormElement>('[data-donate]');
	const label = form?.querySelector<HTMLElement>('[data-donate-label]');

	const sync = () => {
		if (!form || !label) return;
		const data = new FormData(form);
		const amount = data.get('amount');
		const monthly = data.get('frequency') === 'monthly';
		label.textContent = `Donate $${amount}${monthly ? ' monthly' : ''}`;
	};

	form?.addEventListener('change', sync);
	sync();

	// No payment provider yet (DONATE_URL is an on-page anchor) — don't reload the page with form data.
	form?.addEventListener('submit', (event) => {
		if (form.getAttribute('action')?.startsWith('#')) event.preventDefault();
	});
</script>
