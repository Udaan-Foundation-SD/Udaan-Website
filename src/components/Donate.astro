---
import { Image } from 'astro:assets';
import banyan from '../assets/banyan.jpg';

// Home page donate call-to-action. No form here — everything points to /donate.
// As the panel scrolls by, a flight trail draws itself and the bird flies along it,
// landing beside a circular "Donate" seal whose lettering turns with the scroll (script below).

// Composition coordinates (SVG viewBox 0 0 480 440)
const seal = { x: 350, y: 290 };
const flightPath =
	'M16 420C100 360 30 230 140 190C240 155 300 110 236 64C180 26 140 110 214 170C236 188 254 198 276 206';
const bird =
	'M60 18C58 15.5 55 13.5 52 14C49 14.5 47 17 44 21.5C39 13 31 5.5 21 2C25.5 9.5 28 18 29.5 27C24 30.5 18 33.5 12 35.5L2 33.5L8.5 40L3.5 47L14 41.5C28 41 41 35 50 26.5C54 23.5 57 20.5 60 18Z';
const ringText = 'DONATE TO UDAAN · DONATE TO UDAAN · ';
---

<section id="donate" class="pb-24 lg:pb-36">
	<!-- Widens into place like the other panels (data-widen) -->
	<div
		class="bg-canopy relative isolate mx-[calc(var(--inset-max)*var(--k,1))] overflow-hidden rounded-[calc(8px+12px*var(--k,1))] text-white [--inset-max:12px] lg:[--inset-max:48px]"
		data-widen
		data-flight
	>
		<!-- Faint banyan texture -->
		<Image
			src={banyan}
			alt=""
			widths={[960, 1500]}
			sizes="100vw"
			class="absolute inset-0 -z-10 h-full w-full object-cover opacity-[0.13] mix-blend-luminosity saturate-0"
		/>

		<div class="grid items-center gap-6 px-6 py-16 md:px-12 lg:grid-cols-12 lg:gap-10 lg:px-16 lg:py-24">
			<div class="lg:col-span-6">
				<p class="font-ui text-[11px] font-semibold tracking-[0.16em] text-white/70 uppercase" data-reveal>Donate</p>
				<h2
					class="mt-4 font-serif text-5xl leading-[1] font-medium tracking-[-0.02em] text-balance md:text-6xl lg:text-7xl"
					data-reveal
					style="--delay: 80ms"
				>
					Help them <em class="italic">take flight.</em>
				</h2>
				<p class="mt-6 max-w-md font-serif text-lg leading-snug text-white/80 md:text-xl" data-reveal style="--delay: 160ms">
					<span class="font-devanagari" lang="hi">उड़ान</span>, Udaan, means “flight.” A gift of any size helps vetted
					grassroots partners like Gurukulam give children room to rise.
				</p>
				<a
					href="/donate"
					class="group font-ui mt-8 inline-flex items-center gap-2 text-[13.5px] font-semibold text-white/85 transition-colors hover:text-white"
					data-reveal
					style="--delay: 240ms"
				>
					See where your gift goes
					<svg
						viewBox="0 0 16 16"
						class="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						aria-hidden="true"
					>
						<path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
			</div>

			<!-- Flight trail + bird + seal, all one scalable SVG; the whole thing is the donate link -->
			<a href="/donate" class="group mx-auto block w-full max-w-[380px] lg:col-span-6 lg:max-w-[520px]" aria-label="Donate to Udaan">
				<svg viewBox="0 0 480 440" class="block h-auto w-full overflow-visible" aria-hidden="true">
					<defs>
						<path id="seal-ring-path" d={`M${seal.x} ${seal.y}m-66 0a66 66 0 1 1 132 0a66 66 0 1 1-132 0`}></path>
					</defs>

					<!-- Trail (drawn with the scroll) -->
					<path
						d={flightPath}
						fill="none"
						stroke="rgb(255 255 255 / 0.4)"
						stroke-width="1.5"
						stroke-linecap="round"
						data-flight-path></path>

					<!-- Seal -->
					<circle cx={seal.x} cy={seal.y} r="88" fill="none" stroke="rgb(255 255 255 / 0.18)"></circle>
					<g class="seal-ring" data-flight-ring>
						<text class="font-ui" fill="white" font-size="12.5" font-weight="600" letter-spacing="2.4">
							<textPath href="#seal-ring-path" textLength="408" lengthAdjust="spacing">{ringText}</textPath>
						</text>
					</g>
					<g class="seal-core">
						<circle cx={seal.x} cy={seal.y} r="46" fill="white"></circle>
						<g class="seal-arrow" transform={`translate(${seal.x - 14} ${seal.y - 14})`}>
							<path d="M7 21 21 7M9.5 7H21v11.5" fill="none" stroke="#1a1814" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
						</g>
					</g>

					<!-- Bird (positioned along the trail by the script; rests at the end without JS) -->
					<g data-flight-bird transform="translate(276 206) rotate(42)">
						<path d={bird} fill="white" transform="translate(-19 -15) scale(0.62)"></path>
					</g>
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.seal-ring {
		transform-box: view-box;
		transform-origin: 350px 290px;
		rotate: var(--seal-rot, 0deg);
	}
	.seal-core {
		transform-box: view-box;
		transform-origin: 350px 290px;
		transition: scale 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.seal-arrow path {
		transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	a:hover .seal-core,
	a:focus-visible .seal-core {
		scale: 1.08;
	}
	a:hover .seal-arrow path,
	a:focus-visible .seal-arrow path {
		translate: 2px -2px;
	}
</style>

<script>
	// Scroll-linked flight: draw the trail, move + tilt the bird along it, turn the seal's lettering.
	const panel = document.querySelector<HTMLElement>('[data-flight]');
	const path = panel?.querySelector<SVGPathElement>('[data-flight-path]');
	const bird = panel?.querySelector<SVGGElement>('[data-flight-bird]');
	const ring = panel?.querySelector<SVGGElement>('[data-flight-ring]');

	if (panel && path && bird && ring && document.documentElement.classList.contains('motion')) {
		const length = path.getTotalLength();
		const HEADING = 21.8; // the bird artwork faces ~22° above horizontal
		path.style.strokeDasharray = `${length}`;

		const place = (t: number) => {
			path.style.strokeDashoffset = `${length * (1 - t)}`;

			const at = Math.max(0.001, Math.min(length - 0.5, length * t));
			const p = path.getPointAtLength(at);
			const ahead = path.getPointAtLength(Math.min(length, at + 1));
			const angle = (Math.atan2(ahead.y - p.y, ahead.x - p.x) * 180) / Math.PI;
			bird.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${(angle + HEADING).toFixed(1)})`);
			bird.style.opacity = t < 0.02 ? '0' : '1';

			ring.style.setProperty('--seal-rot', `${(t * 200).toFixed(1)}deg`);
		};

		// Time the flight to the drawing itself (on phones it sits below the text, not beside it):
		// it starts as the drawing enters the bottom of the screen and lands once it's fully in view.
		const drawing = path.ownerSVGElement!;
		let queued = false;
		const update = () => {
			queued = false;
			const rect = drawing.getBoundingClientRect();
			const vh = window.innerHeight;
			const t = Math.min(Math.max((vh * 0.95 - rect.top) / (vh * 0.2 + rect.height), 0), 1);
			place(t);
		};
		const queue = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};
		window.addEventListener('scroll', queue, { passive: true });
		window.addEventListener('resize', queue);
		update();
	}
</script>
